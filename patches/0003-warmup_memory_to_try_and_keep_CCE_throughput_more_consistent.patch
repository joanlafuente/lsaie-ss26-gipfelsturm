+    def compute_language_model_loss_CCE(
+            self,
+            labels: Tensor,
+            hidden_states: Tensor,
+            weight: Tensor,
+            bias: Optional[Tensor] = None
+        ) -> Tensor:
+            """
+            Computes the vocab-parallel language model loss using Apple's Cut Cross-Entropy.
+            """
+            # hidden_states: [s, b, h],  labels: [b, s]
+            s, b, h = hidden_states.shape
+
+            # Flatten to 2D/1D so CCE returns a 1D loss tensor.
+            # This avoids a non-contiguous gradient in CCE's backward: if we passed
+            # [s, b] and got [s, b] back, the transpose in the return path would make
+            # the gradient non-contiguous and break grad_out.view(-1) inside CCE.
+            # Token ordering: index k = i*b + j  <->  seq_pos i, batch j.
+            hidden_flat = hidden_states.reshape(s * b, h)            # [s*b, h]
+            labels_flat = labels.transpose(0, 1).reshape(-1)         # [b,s]->[s,b]->flat [s*b]
+
+            tp_group = self.pg_collection.tp
+            tp_rank = torch.distributed.get_rank(group=tp_group)
+
+            # Fix for ZERO-2 (as we are not computing the logits in the output layer we are not using the hooks)
+            weight_module = self.embedding.word_embeddings if self.share_embeddings_and_output_weights else self.output_layer
+
+            if hasattr(weight_module, '_forward_pre_hooks'):
+                for hook in weight_module._forward_pre_hooks.values():
+                    hook(weight_module, (hidden_states,))
+
+            per_partition_vocab_size = weight.shape[0]
+            vocab_start_index = tp_rank * per_partition_vocab_size
+            vocab_stop_index = vocab_start_index + per_partition_vocab_size
+
+            vp_opts = VocabParallelOptions(
+                vocab_start_index,
+                vocab_stop_index,
+                group=tp_group
+            )
+
+            # Returns [s*b]. The gradient flowing back through the reshape/transpose
+            # chain below would otherwise be non-contiguous when it reaches CCE's
+            # grad_out.view(-1); _ForceContiguousGrad below restores contiguity.
+            loss = linear_cross_entropy(
+                hidden_flat,
+                weight,
+                labels_flat,
+                bias=bias,
+                vocab_parallel_options=vp_opts,
+                reduction='none'
+            )
+
+            # [s*b] => [s, b] => [b, s]
+            loss_sb = loss.reshape(s, b)
+            loss_sb = _ForceContiguousGrad.apply(loss_sb)
+            return loss_sb.transpose(0, 1).contiguous()
+
+
