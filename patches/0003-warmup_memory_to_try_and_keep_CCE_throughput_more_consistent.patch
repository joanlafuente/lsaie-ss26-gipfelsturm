+def _prewarm_optimizer_states(optimizer):
+    """Pre-allocate Adam moment buffers (exp_avg, exp_avg_sq) before training starts.
+
+    Without this, the buffers are allocated lazily on the first optimizer step.
+    Pre-allocating them ensures the CUDA memory footprint is at its steady-state
+    level from step 1, so CCE can pick a stable tile size immediately.
+    """
+    from megatron.core.optimizer.optimizer import ChainedOptimizer
+
+    leaf_optimizers = (
+        optimizer.chained_optimizers
+        if isinstance(optimizer, ChainedOptimizer)
+        else [optimizer]
+    )
+
+    for leaf_opt in leaf_optimizers:
+        init_fn = getattr(leaf_opt, 'init_state_fn', None)
+        inner = getattr(leaf_opt, 'optimizer', None)
+        if init_fn is not None and inner is not None:
+            config = getattr(leaf_opt, 'config', None)
+            init_fn(inner, config)
+
+
+def _prewarm_cce_allocator(args):
+    """Prime the CUDA caching allocator to its steady-state high-watermark.
+
+    Allocates a large dummy tensor (controlled by --cce-allocator-warmup-fraction)
+    and immediately frees it. The freed block stays in the allocator's cache —
+    do NOT call torch.cuda.empty_cache() after this. The cached block gives CCE
+    a large contiguous pool for its vocabulary tiling from the very first step,
+    matching the tile size it would otherwise only reach after ~250 warm-up steps.
+
+    A fraction of 0.7–0.85 is typical; start lower if OOM errors occur.
+    """
+    fraction = getattr(args, 'cce_allocator_warmup_fraction', 0.0)
+    if fraction <= 0.0:
+        return
+
+    device = torch.cuda.current_device()
+    free_bytes, _ = torch.cuda.mem_get_info(device)
+    reserve_bytes = int(free_bytes * fraction)
+    # float16 = 2 bytes per element
+    reserve_elements = reserve_bytes // 2
+
+    if reserve_elements <= 0:
+        return
+
+    try:
+        dummy = torch.empty(reserve_elements, dtype=torch.float16, device=device)
+        del dummy
+        # Intentionally no torch.cuda.empty_cache() — the freed block stays in
+        # the allocator's cache as a large contiguous pool for CCE tiling.
+        print_rank_0(
+            f'> CCE allocator warmup: primed {reserve_bytes / 1e9:.2f} GB '
+            f'in CUDA allocator cache (fraction={fraction}).'
+        )
+    except torch.cuda.OutOfMemoryError:
+        print_rank_0(
+            f'> CCE allocator warmup: could not allocate '
+            f'{reserve_bytes / 1e9:.2f} GB — skipping (try a smaller fraction).'
+        )
+
+
 def train(
