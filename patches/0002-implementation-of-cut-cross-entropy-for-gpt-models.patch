 from megatron.core import parallel_state, tensor_parallel
 from megatron.core.dist_checkpointing.mapping import ShardedStateDict
 
+from cut_cross_entropy import linear_cross_entropy, VocabParallelOptions
+
+
+class _ForceContiguousGrad(torch.autograd.Function):
+    """Identity in forward, but forces grad_output contiguous in backward.
+
+    Why: when we do `loss.reshape(s, b).transpose(0, 1).contiguous()` on the
+    contiguous 1D output of CCE, autograd treats `.reshape` as a `.view`
+    (because the input is contiguous). The view's backward then tries to view
+    the incoming gradient — which is non-contiguous after the transpose
+    backward applies — as 1D, raising the "view size is not compatible with
+    input tensor's size and stride" error inside CCE's `grad_out.view(-1)`.
+
+    Inserting this op between the reshape and the transpose ensures the
+    gradient is made contiguous *before* it reaches the view-style reshape
+    backward, breaking the non-contiguous chain.
+    """
+
+    @staticmethod
+    def forward(ctx, x):
+        return x
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        return grad_output.contiguous()
+
